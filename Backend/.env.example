NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-this-demo-secret-before-deploying

# Demo connection values only. Replace with your TiDB/MySQL connection details.
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=demo_user
DB_PASSWORD=change-me
DB_NAME=campusshare
DB_SSL=true

# Cloudinary image uploads (JPEG/PNG/WebP converted to WebP).
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Gmail SMTP. Create a Google App Password and enter it locally; never commit it.
# Required for signup OTP verification, password reset, and event notifications.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Frontend hosting. Leave empty when this server also serves the Frontend folder.
# If the API lives on another host, set Frontend/js/config.js apiBase to that host
# and list the frontend origin(s) here (comma separated), e.g. https://campusshare.netlify.app
CORS_ORIGIN=

# Request log line per API call in the server console. Set to false to silence it.
LOG_REQUESTS=true