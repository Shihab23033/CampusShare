NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-this-demo-secret-before-deploying

# Demo connection values only. Replace with your TiDB/MySQL connection details.
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=demo_user
DB_PASSWORD=change-me
DB_NAME=campusshare
DB_SSL=true

# Cloudinary image uploads (JPEG/PNG/WebP converted to WebP).
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Outgoing mail: Brevo SMTP (Settings -> SMTP & API inside your Brevo account).
# Copy the host, your account login, and generate an SMTP key (the key is the password).
# Leave these empty to fall back to the Gmail settings below.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional sender shown in the inbox, e.g. CampusShare <no-reply@yourdomain.com>.
# Leave empty to send from your Brevo account address (safest until a sending domain is validated).
SMTP_FROM=

# Gmail fallback (used only when SMTP_HOST/SMTP_USER/SMTP_PASSWORD are empty).
# Create a Google App Password; never commit it.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Frontend hosting. Leave empty when this server also serves the Frontend folder.
# If the API lives on another host, set Frontend/js/config.js apiBase to that host
# and list the frontend origin(s) here (comma separated), e.g. https://campusshare.netlify.app
CORS_ORIGIN=

# Request log line per API call in the server console. Set to false to silence it.
LOG_REQUESTS=true